# 复制为 .env 后填写自己的 Key（.env 不会提交到仓库）
# Copy to .env and fill in your own keys (.env is git-ignored)

# 主对话与内容生成（OpenAI 兼容接口，exercise.py 默认 DashScope）
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# app.py 使用的 OpenAI 兼容地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 图片识别（阿里云 DashScope）
DASHSCOPE_API_KEY=

# 讯飞：文生图、场景识别
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# Tripo3D：图片生成 3D 模型
TRIPO3D_API_KEY=
